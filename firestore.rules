rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function owner() {
      return verified() && request.auth.uid == 'ljYr2MF28zg1zAFsD7M1sNH6s8O2';
    }
    function self(uid) {
      return verified() && request.auth.uid == uid;
    }
    function notBlocked(a, b) {
      return a == b || (!exists(/databases/$(database)/documents/users/$(a)/blocked/$(b))
        && !exists(/databases/$(database)/documents/users/$(b)/blocked/$(a)));
    }
    function measurementNumber(data, key, minimum, maximum) {
      return !(key in data) || (data[key] is number && data[key] >= minimum && data[key] <= maximum);
    }
    function validMeasurement(id) {
      let data=request.resource.data;
      return data.keys().hasOnly(['date','weight','waist','chest','hips','biceps','thigh','note','updatedAt'])
        && data.date == id && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.keys().hasAny(['weight','waist','chest','hips','biceps','thigh'])
        && data.get('note','') is string && data.get('note','').size() <= 500
        && data.get('updatedAt',0) is number && data.get('updatedAt',0) >= 0
        && measurementNumber(data,'weight',20,500) && measurementNumber(data,'waist',20,300)
        && measurementNumber(data,'chest',20,300) && measurementNumber(data,'hips',20,300)
        && measurementNumber(data,'biceps',5,100) && measurementNumber(data,'thigh',10,200);
    }
    function validIpEntry(entry) {
      return entry is map && entry.keys().hasAll(['ip', 'time']) && entry.keys().hasOnly(['ip', 'time'])
        && entry.ip is string && entry.ip.size() > 0 && entry.ip.size() <= 45
        && entry.ip.matches('[0-9a-fA-F:.]+') && entry.time is string && entry.time.size() <= 40;
    }
    function validIpHistory() {
      let history = request.resource.data.get('loginIpHistory', []);
      return history is list && history.size() <= 5
        && (history.size() < 1 || validIpEntry(history[0]))
        && (history.size() < 2 || validIpEntry(history[1]))
        && (history.size() < 3 || validIpEntry(history[2]))
        && (history.size() < 4 || validIpEntry(history[3]))
        && (history.size() < 5 || validIpEntry(history[4]));
    }
    // A number, its lookup and the profile must be allocated in one transaction.
    function nextNumber() {
      return exists(/databases/$(database)/documents/counters/users)
        ? get(/databases/$(database)/documents/counters/users).data.lastId + 1 : 1;
    }
    function allocation(uid, number) {
      return number is int && number > 0 && number == nextNumber()
        && getAfter(/databases/$(database)/documents/counters/users).data.lastId == number
        && !exists(/databases/$(database)/documents/userNumbers/$(string(number)))
        && getAfter(/databases/$(database)/documents/userNumbers/$(string(number))).data.uid == uid;
    }

    match /users/{uid} {
      allow get: if self(uid) || owner();
      allow list: if owner();
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'createdAt', 'activeProgramId', 'customId'])
        && request.resource.data.email == request.auth.token.email
        && allocation(uid, request.resource.data.customId);
      allow update: if self(uid) && validIpHistory() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photo', 'activeProgramId', 'lastActiveAt', 'lastDeviceId',
          'lastLogin', 'lastLoginIp', 'lastLoginTime', 'registeredAt', 'loginIpHistory'
        ]) || (
          !('customId' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customId'])
          && allocation(uid, request.resource.data.customId)
        )
      );
      match /{collection}/{document} {
        allow read: if (self(uid) || owner())
          && collection in ['programs', 'sessions', 'exercises', 'exercisePreferences', 'programShares'];
        allow write: if self(uid)
          && collection in ['programs', 'sessions', 'exercises', 'exercisePreferences', 'programShares'];
      }
      match /notifications/{id} {
        allow read, delete: if self(uid);
        allow create: if validNotice(uid, id);
        allow update: if (self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool) || validNotice(uid, id);
      }
      match /measurements/{id} {
        allow read, delete: if self(uid);
        allow create, update: if self(uid) && validMeasurement(id);
      }
      match /blocked/{other} {
        allow get: if self(uid) || self(other);
        allow list: if self(uid);
        allow create, update: if self(uid) && uid != other
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
        allow delete: if self(uid);
      }
    }

    match /counters/users {
      allow get: if verified();
      allow create, update: if verified()
        && request.resource.data.keys().hasOnly(['lastId'])
        && request.resource.data.lastId == nextNumber()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.customId == request.resource.data.lastId
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !('customId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data))
        && allocation(request.auth.uid, request.resource.data.lastId);
    }
    match /userNumbers/{number} {
      allow get: if verified();
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && number == string(nextNumber())
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.customId == nextNumber()
        && getAfter(/databases/$(database)/documents/counters/users).data.lastId == nextNumber();
    }

    match /userAccess/{uid} {
      allow get: if self(uid) || owner();
      allow list: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['homeWorkouts'])
        && request.resource.data.homeWorkouts is bool;
      allow delete: if owner();
    }
    match /settings/{id} {
      allow read: if verified();
      allow write: if owner();
    }
    match /programTemplates/{id} {
      allow read: if verified();
      allow write: if owner();
    }
    match /exercises/{id} {
      allow read: if verified();
      allow write: if owner();
      match /ratings/{uid} {
        allow read: if verified();
        allow create, update: if self(uid)
          && exists(/databases/$(database)/documents/exercises/$(id))
          && request.resource.data.keys().hasOnly(['score', 'updatedAt'])
          && request.resource.data.score is int
          && request.resource.data.score >= 0 && request.resource.data.score <= 5
          && request.resource.data.updatedAt == request.time;
        allow delete: if self(uid) || owner();
      }
      match /comments/{comment} {
        allow read: if verified();
        allow create: if verified()
          && exists(/databases/$(database)/documents/exercises/$(id))
          && request.resource.data.keys().hasOnly(['text', 'authorId', 'authorName', 'createdAt'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.authorName is string && request.resource.data.authorName.size() <= 100
          && request.resource.data.createdAt == request.time;
        allow delete: if owner() || (verified() && resource.data.authorId == request.auth.uid);
      }
    }
    match /sharedPrograms/{token} {
      allow get: if verified();
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['senderId', 'program'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.program is map;
      allow update: if verified() && resource.data.senderId == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.keys().hasOnly(['senderId', 'program'])
        && request.resource.data.program is map;
      allow delete: if owner() || (verified() && resource.data.senderId == request.auth.uid);
    }
    function validPublicProfile(uid) {
      let data = request.resource.data;
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return data.keys().hasAll(['name', 'photo', 'customId', 'joinedAt'])
        && data.keys().hasOnly(['name', 'photo', 'customId', 'joinedAt', 'contacts', 'visibility', 'bio', 'banner', 'location'])
        && data.get('location', '') is string && data.get('location', '').size() <= 100
        && data.get('banner', '') is string && data.get('banner', '').size() <= 480000
        && (data.get('banner', '') == '' || data.banner.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))
        && validContacts(data.get('contacts', {}))
        && validVisibility(data.get('visibility', {}))
        && data.get('bio', '') is string && data.get('bio', '').size() <= 400
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.photo is string && data.photo.size() <= 180000
        && (data.photo == '' || data.photo.matches('https://.*')
          || data.photo.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))
        && data.customId == profile.customId && data.joinedAt == profile.createdAt;
    }
    function validContacts(contacts) {
      return contacts is map && contacts.keys().hasOnly(['instagram', 'telegram'])
        && contacts.get('instagram', '') is string && contacts.get('telegram', '') is string
        && (contacts.get('instagram', '') == '' || contacts.instagram.matches('https://instagram[.]com/[A-Za-z0-9_][A-Za-z0-9_.]{0,29}'))
        && (contacts.get('telegram', '') == '' || contacts.telegram.matches('https://t[.]me/[A-Za-z][A-Za-z0-9_]{4,31}'));
    }
    function validVisibility(value) {
      return value is map && value.keys().hasOnly(['lastActive', 'progress', 'records', 'streak', 'gymBros'])
        && value.get('lastActive', false) is bool && value.get('progress', false) is bool
        && value.get('records', false) is bool && value.get('streak', false) is bool && value.get('gymBros', true) is bool;
    }
    function acceptedPair(uid, friend) {
      let forward = /databases/$(database)/documents/gymBros/$(uid + '_' + friend);
      let reverse = /databases/$(database)/documents/gymBros/$(friend + '_' + uid);
      return uid != friend && ((existsAfter(forward) && getAfter(forward).data.status == 'accepted'
          && getAfter(forward).data.members.hasAll([uid, friend]))
        || (existsAfter(reverse) && getAfter(reverse).data.status == 'accepted'
          && getAfter(reverse).data.members.hasAll([uid, friend])));
    }
    function validUserTag(tag) {
      return tag is map && tag.keys().hasAll(['text', 'color', 'textColor']) && tag.keys().hasOnly(['text', 'color', 'textColor'])
        && tag.text is string && tag.text.size() > 0 && tag.text.size() <= 40
        && tag.color is string && tag.color.matches('#[0-9a-fA-F]{6}')
        && tag.textColor is string && tag.textColor.matches('#[0-9a-fA-F]{6}');
    }
    match /userLabels/{uid} {
      allow get: if verified();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['tags']) && request.resource.data.tags is list
        && request.resource.data.tags.size() <= 5
        && (request.resource.data.tags.size() < 1 || validUserTag(request.resource.data.tags[0]))
        && (request.resource.data.tags.size() < 2 || validUserTag(request.resource.data.tags[1]))
        && (request.resource.data.tags.size() < 3 || validUserTag(request.resource.data.tags[2]))
        && (request.resource.data.tags.size() < 4 || validUserTag(request.resource.data.tags[3]))
        && (request.resource.data.tags.size() < 5 || validUserTag(request.resource.data.tags[4]));
      allow delete: if owner();
    }
    match /publicProfiles/{uid} {
      allow get: if verified();
      allow create, update: if self(uid) && validPublicProfile(uid);
      match /friends/{friend} {
        allow read: if self(uid) || self(friend) || (verified()
          && get(/databases/$(database)/documents/publicProfiles/$(uid)).data.get('visibility', {}).get('gymBros', true) == true);
        allow create, update: if verified() && (request.auth.uid == uid || request.auth.uid == friend)
          && notBlocked(uid, friend) && acceptedPair(uid, friend) && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == friend;
        allow delete: if verified() && (request.auth.uid == uid || request.auth.uid == friend);
      }
      match /stats/{kind} {
        allow get: if self(uid) || owner() || (verified()
          && get(/databases/$(database)/documents/publicProfiles/$(uid)).data.get('visibility', {}).get(kind, false) == true);
        allow create, update: if self(uid) && (
          (kind == 'lastActive' && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time)
          || (kind == 'progress' && request.resource.data.keys().hasOnly(['workouts', 'sets', 'volume'])
            && request.resource.data.workouts is int && request.resource.data.workouts >= 0
            && request.resource.data.sets is int && request.resource.data.sets >= 0
            && request.resource.data.volume is number && request.resource.data.volume >= 0)
          || (kind == 'records' && request.resource.data.keys().hasOnly(['items'])
            && request.resource.data.items is list && request.resource.data.items.size() <= 200)
          || (kind == 'streak' && request.resource.data.keys().hasOnly(['current', 'best', 'trainedThisWeek', 'lastWorkoutDate'])
            && request.resource.data.current is int && request.resource.data.best is int
            && request.resource.data.current >= 0 && request.resource.data.best >= 0
            && request.resource.data.trainedThisWeek is bool && request.resource.data.lastWorkoutDate is string)
        );
      }
      match /comments/{comment} {
        allow read: if verified();
        allow create: if verified()
          && notBlocked(request.auth.uid, uid)
          && exists(/databases/$(database)/documents/publicProfiles/$(uid))
          && request.resource.data.keys().hasAll(['authorId', 'authorName', 'text', 'createdAt'])
          && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt', 'parentId'])
          && request.resource.data.get('parentId', '') is string
          && (request.resource.data.get('parentId', '') == '' || (
            exists(/databases/$(database)/documents/publicProfiles/$(uid)/comments/$(request.resource.data.parentId))
            && get(/databases/$(database)/documents/publicProfiles/$(uid)/comments/$(request.resource.data.parentId)).data.get('parentId', '') == ''
            && notBlocked(request.auth.uid, get(/databases/$(database)/documents/publicProfiles/$(uid)/comments/$(request.resource.data.parentId)).data.authorId)
          ))
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.name
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow delete: if self(uid) || owner() || (verified() && resource.data.authorId == request.auth.uid);
        match /likes/{liker} {
          allow read: if verified();
          allow create: if self(liker) && exists(/databases/$(database)/documents/publicProfiles/$(uid)/comments/$(comment))
            && notBlocked(request.auth.uid, uid)
            && notBlocked(request.auth.uid, get(/databases/$(database)/documents/publicProfiles/$(uid)/comments/$(comment)).data.authorId)
            && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
          allow delete: if self(liker);
        }
      }
    }
    match /gymBros/{id} {
      allow read: if verified() && request.auth.uid in resource.data.members;
      allow create: if verified()
        && notBlocked(request.auth.uid, request.resource.data.to)
        && request.resource.data.keys().hasAll(['from', 'to', 'members', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['from', 'to', 'members', 'status', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.members == [request.auth.uid, request.resource.data.to]
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && id == request.auth.uid + '_' + request.resource.data.to
        && exists(/databases/$(database)/documents/publicProfiles/$(request.auth.uid))
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.to))
        && !existsAfter(/databases/$(database)/documents/gymBros/$(request.resource.data.to + '_' + request.auth.uid));
      allow update: if verified() && resource.data.to == request.auth.uid
        && notBlocked(resource.data.from, resource.data.to)
        && resource.data.status == 'pending' && request.resource.data.status == 'accepted'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if verified() && request.auth.uid in resource.data.members
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(resource.data.from)/friends/$(resource.data.to))
        && !existsAfter(/databases/$(database)/documents/publicProfiles/$(resource.data.to)/friends/$(resource.data.from));
    }
    function validNotice(uid, id) {
      let data = request.resource.data;
      return verified() && uid != request.auth.uid && notBlocked(uid, request.auth.uid)
        && data.keys().hasAll(['type', 'actorId', 'profileId', 'targetId', 'createdAt', 'read'])
        && data.keys().hasOnly(['type', 'actorId', 'profileId', 'targetId', 'createdAt', 'read'])
        && data.actorId == request.auth.uid && data.profileId is string && data.targetId is string
        && data.createdAt == request.time && data.read == false
        && id == data.type + '_' + data.targetId
        && (((data.type == 'comment' || data.type == 'reply') && commentNotice(uid, data))
          || (data.type == 'friend_request' && requestNotice(uid, data))
          || (data.type == 'friend_accepted' && acceptedNotice(uid, data))
          || (data.type in ['training_invite', 'training_accepted'] && trainingNotice(uid, data)));
    }
    function commentNotice(uid, data) {
      let path = /databases/$(database)/documents/publicProfiles/$(data.profileId)/comments/$(data.targetId);
      let comment = getAfter(path).data;
      return !exists(path) && comment.authorId == request.auth.uid && comment.createdAt == request.time
        && ((data.type == 'comment' && uid == data.profileId) || (data.type == 'reply'
          && comment.get('parentId', '') != ''
          && get(/databases/$(database)/documents/publicProfiles/$(data.profileId)/comments/$(comment.parentId)).data.authorId == uid));
    }
    function requestNotice(uid, data) {
      let path = /databases/$(database)/documents/gymBros/$(data.targetId);
      let relation = getAfter(path).data;
      return !exists(path) && relation.from == request.auth.uid && relation.to == uid
        && relation.status == 'pending' && relation.createdAt == request.time && data.profileId == request.auth.uid;
    }
    function acceptedNotice(uid, data) {
      let path = /databases/$(database)/documents/gymBros/$(data.targetId);
      return get(path).data.status == 'pending' && getAfter(path).data.status == 'accepted'
        && getAfter(path).data.to == request.auth.uid && getAfter(path).data.from == uid
        && data.profileId == request.auth.uid;
    }
    function trainingNotice(uid, data) {
      let path = /databases/$(database)/documents/trainingInvites/$(data.targetId);
      let invite = getAfter(path).data;
      return (data.type == 'training_invite' && !exists(path) && invite.from == request.auth.uid
          && invite.to == uid && invite.status == 'pending' && invite.createdAt == request.time && data.profileId == request.auth.uid)
        || (data.type == 'training_accepted' && get(path).data.status == 'pending' && invite.status == 'accepted'
          && invite.to == request.auth.uid && invite.from == uid && data.profileId == request.auth.uid);
    }
    match /trainingInvites/{id} {
      allow read: if verified() && request.auth.uid in resource.data.members;
      allow create: if verified() && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && notBlocked(request.auth.uid, request.resource.data.to) && acceptedPair(request.auth.uid, request.resource.data.to)
        && request.resource.data.keys().hasAll(['from', 'to', 'members', 'program', 'date', 'time', 'note', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['from', 'to', 'members', 'program', 'date', 'time', 'note', 'status', 'createdAt'])
        && request.resource.data.members == [request.auth.uid, request.resource.data.to]
        && request.resource.data.status == 'pending' && request.resource.data.createdAt == request.time
        && request.resource.data.program is map && request.resource.data.program.name is string && request.resource.data.program.name.size() <= 100
        && request.resource.data.program.days is list && request.resource.data.program.days.size() == 1
        && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.time is string && (request.resource.data.time == '' || request.resource.data.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]'))
        && request.resource.data.note is string && request.resource.data.note.size() <= 300;
      allow update: if verified() && resource.data.status == 'pending' && request.resource.data.respondedAt == request.time && (
        (resource.data.from == request.auth.uid && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']))
        || (resource.data.to == request.auth.uid && request.resource.data.status == 'declined'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']))
        || (resource.data.to == request.auth.uid && request.resource.data.status == 'accepted' && notBlocked(resource.data.from, resource.data.to)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt', 'sessionId'])
          && request.resource.data.sessionId == 'invite_' + id
          && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/sessions/$(request.resource.data.sessionId))
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/sessions/$(request.resource.data.sessionId)).data.status == 'planned'
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/sessions/$(request.resource.data.sessionId)).data.invitationId == id));
    }
    match /reports/{id} {
      allow get: if owner() || (verified() && (!exists(/databases/$(database)/documents/reports/$(id)) || resource.data.reporterId == request.auth.uid));
      allow list: if owner();
      allow create: if verified() && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.targetId is string && request.resource.data.targetId != request.auth.uid
        && request.resource.data.keys().hasAll(['reporterId', 'targetId', 'profileId', 'commentId', 'commentText', 'reason', 'detail', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['reporterId', 'targetId', 'profileId', 'commentId', 'commentText', 'reason', 'detail', 'status', 'createdAt'])
        && request.resource.data.profileId is string && request.resource.data.commentId is string
        && request.resource.data.reason in ['abuse', 'spam', 'impersonation', 'other']
        && request.resource.data.detail is string && request.resource.data.detail.size() <= 1000
        && request.resource.data.commentText is string && request.resource.data.commentText.size() <= 2000
        && request.resource.data.status == 'open' && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/publicProfiles/$(request.resource.data.targetId))
        && id == request.auth.uid + '_' + request.resource.data.targetId + '_' + (request.resource.data.commentId == '' ? 'profile' : request.resource.data.commentId)
        && ((request.resource.data.commentId == '' && request.resource.data.commentText == '' && request.resource.data.profileId == request.resource.data.targetId)
          || (request.resource.data.commentId != ''
            && get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.profileId)/comments/$(request.resource.data.commentId)).data.authorId == request.resource.data.targetId
            && get(/databases/$(database)/documents/publicProfiles/$(request.resource.data.profileId)/comments/$(request.resource.data.commentId)).data.text == request.resource.data.commentText));
      allow update: if owner() && request.resource.data.status in ['reviewed', 'dismissed'] && request.resource.data.reviewedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt']);
    }
    // All other paths and operations are denied by default.
  }
}
