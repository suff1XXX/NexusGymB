rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function owner() {
      return verified() && request.auth.uid == 'ljYr2MF28zg1zAFsD7M1sNH6s8O2';
    }
    function self(uid) {
      return verified() && request.auth.uid == uid;
    }
    function notBlocked(a, b) {
      return a == b || (!exists(/databases/$(database)/documents/users/$(a)/blocked/$(b))
        && !exists(/databases/$(database)/documents/users/$(b)/blocked/$(a)));
    }
    function profileFriend(uid) {
      let other=request.auth.uid;
      let forward=/databases/$(database)/documents/gymBros/$(uid + '_' + other);
      let reverse=/databases/$(database)/documents/gymBros/$(other + '_' + uid);
      return (exists(forward) && get(forward).data.status == 'accepted' && get(forward).data.members.hasAll([uid,other]))
        || (exists(reverse) && get(reverse).data.status == 'accepted' && get(reverse).data.members.hasAll([uid,other]));
    }
    function canViewProfile(uid) {
      return verified() && (self(uid) || owner()
        || (exists(/databases/$(database)/documents/publicProfiles/$(uid))
          && (get(/databases/$(database)/documents/publicProfiles/$(uid)).data.get('isPrivate',false) == false || profileFriend(uid))));
    }
    function validCommentFormatting() {
      return request.resource.data.get('richText','') is string && request.resource.data.get('richText','').size() <= 16000;
    }
    function measurementNumber(data, key, minimum, maximum) {
      return !(key in data) || (data[key] is number && data[key] >= minimum && data[key] <= maximum);
    }
    function validMeasurement(id) {
      let data=request.resource.data;
      return data.keys().hasOnly(['date','weight','waist','chest','hips','biceps','thigh','note','updatedAt','profileId'])
        && data.get('profileId','profile-1') is string && data.get('profileId','profile-1').matches('profile-[1-5]')
        && id == (data.get('profileId','profile-1') == 'profile-1' ? data.date : data.profileId + '_' + data.date) && data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && data.keys().hasAny(['weight','waist','chest','hips','biceps','thigh'])
        && data.get('note','') is string && data.get('note','').size() <= 500
        && data.get('updatedAt',0) is number && data.get('updatedAt',0) >= 0
        && measurementNumber(data,'weight',20,500) && measurementNumber(data,'waist',20,300)
        && measurementNumber(data,'chest',20,300) && measurementNumber(data,'hips',20,300)
        && measurementNumber(data,'biceps',5,100) && measurementNumber(data,'thigh',10,200);
    }
    function validIpEntry(entry) {
      return entry is map && entry.keys().hasAll(['ip', 'time']) && entry.keys().hasOnly(['ip', 'time'])
        && entry.ip is string && entry.ip.size() > 0 && entry.ip.size() <= 45
        && entry.ip.matches('[0-9a-fA-F:.]+') && entry.time is string && entry.time.size() <= 40;
    }
    function validIpHistory() {
      let history = request.resource.data.get('loginIpHistory', []);
      return history is list && history.size() <= 5
        && (history.size() < 1 || validIpEntry(history[0]))
        && (history.size() < 2 || validIpEntry(history[1]))
        && (history.size() < 3 || validIpEntry(history[2]))
        && (history.size() < 4 || validIpEntry(history[3]))
        && (history.size() < 5 || validIpEntry(history[4]));
    }
    // A number, its lookup and the profile must be allocated in one transaction.
    function nextNumber() {
      return exists(/databases/$(database)/documents/counters/users)
        ? get(/databases/$(database)/documents/counters/users).data.lastId + 1 : 1;
    }
    function allocation(uid, number) {
      return number is int && number > 0 && number == nextNumber()
        && getAfter(/databases/$(database)/documents/counters/users).data.lastId == number
        && !exists(/databases/$(database)/documents/userNumbers/$(string(number)))
        && getAfter(/databases/$(database)/documents/userNumbers/$(string(number))).data.uid == uid;
    }

    function allowedTrainingProfile(uid,id) {
      return id in ['profile-1','profile-2','profile-3'] || (id in ['profile-4','profile-5']
        && exists(/databases/$(database)/documents/userAccess/$(uid))
        && get(/databases/$(database)/documents/userAccess/$(uid)).data.get('extraTrainingProfiles',false) == true);
    }
    function validTrainingProfile() {
      let data=request.resource.data;
      return data.keys().hasAll(['name','loads','createdAt','updatedAt'])
        && data.keys().hasOnly(['name','loads','createdAt','updatedAt','legacyMachine'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.loads is map && data.loads.size() <= 300
        && data.createdAt is number && data.createdAt >= 0
        && data.updatedAt is number && data.updatedAt >= data.createdAt
        && data.get('legacyMachine','') is string && data.get('legacyMachine','').size() <= 80;
    }
    match /users/{uid} {
      allow get: if self(uid) || owner();
      allow list: if owner();
      allow create: if self(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'createdAt', 'activeProgramId', 'customId'])
        && request.resource.data.email == request.auth.token.email
        && allocation(uid, request.resource.data.customId);
      allow update: if self(uid) && validIpHistory() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'photo', 'activeProgramId', 'lastActiveAt', 'lastDeviceId',
          'lastLogin', 'lastLoginIp', 'lastLoginTime', 'registeredAt', 'loginIpHistory'
        ]) || (
          !('customId' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customId'])
          && allocation(uid, request.resource.data.customId)
        )
      );
      match /{collection}/{document} {
        allow read: if (self(uid) || owner())
          && collection in ['programs', 'sessions', 'exercises', 'exercisePreferences', 'programShares'];
        allow write: if self(uid)
          && collection in ['programs', 'sessions', 'exercises', 'exercisePreferences', 'programShares'];
      }
      match /trainingProfiles/{id} {
        allow read: if self(uid) || owner();
        allow create, update: if self(uid) && allowedTrainingProfile(uid,id) && validTrainingProfile();
      }
      match /trainingProfileSettings/{id} {
        allow read: if self(uid) || owner();
        allow create, update: if self(uid) && id == 'selection'
          && request.resource.data.keys().hasOnly(['activeId','updatedAt'])
          && allowedTrainingProfile(uid,request.resource.data.activeId)
          && (request.resource.data.activeId == 'profile-1' || existsAfter(/databases/$(database)/documents/users/$(uid)/trainingProfiles/$(request.resource.data.activeId)))
          && request.resource.data.updatedAt is number && request.resource.data.updatedAt >= 0;
      }
      match /notifications/{id} {
        allow read, delete: if self(uid);
        allow create: if validNotice(uid, id);
        allow update: if self(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
      }
      match /recordSettings/{id} {
        allow read: if self(uid) && id == 'visibility';
        allow create, update: if self(uid) && id == 'visibility'
          && request.resource.data.keys().hasAll(['visibleKeys','revision'])
          && request.resource.data.keys().hasOnly(['visibleKeys','revision'])
          && request.resource.data.visibleKeys is list && request.resource.data.visibleKeys.size() <= 200
          && request.resource.data.revision is int
          && request.resource.data.revision == (exists(/databases/$(database)/documents/users/$(uid)/recordSettings/visibility) ? resource.data.revision + 1 : 1)
          && getAfter(/databases/$(database)/documents/publicProfiles/$(uid)/stats/records).data.visibilityVersion == request.resource.data.revision;
      }
      match /measurements/{id} {
        allow read, delete: if self(uid);
        allow create, update: if self(uid) && validMeasurement(id);
      }
      match /manualSets/{id} {
        allow read, delete: if self(uid);
        allow create, update: if self(uid)
          && request.resource.data.keys().hasAll(['exercise','exerciseKey','weight','reps','date','createdAt','updatedAt'])
          && request.resource.data.keys().hasOnly(['exercise','exerciseKey','weight','weightBasis','weightSides','reps','repsMax','machine','date','createdAt','updatedAt'])
          && request.resource.data.exercise is string && request.resource.data.exercise.size() > 0 && request.resource.data.exercise.size() <= 100
          && request.resource.data.exerciseKey is string && request.resource.data.exerciseKey.size() > 0 && request.resource.data.exerciseKey.size() <= 180
          && request.resource.data.weight is number && request.resource.data.weight >= 0 && request.resource.data.weight <= 1000
          && ((!('weightBasis' in request.resource.data) && !('weightSides' in request.resource.data))
            || (request.resource.data.keys().hasAll(['weightBasis','weightSides'])
              && request.resource.data.weightBasis in ['total','perHand','perSide']
              && request.resource.data.weightSides is int && request.resource.data.weightSides in [1,2]
              && (request.resource.data.weightBasis != 'total' || request.resource.data.weightSides == 1)))
          && request.resource.data.reps is int && request.resource.data.reps >= 1 && request.resource.data.reps <= 1000
          && (!('repsMax' in request.resource.data) || (request.resource.data.repsMax is int && request.resource.data.repsMax >= request.resource.data.reps && request.resource.data.repsMax <= 1000))
          && (!('machine' in request.resource.data) || (request.resource.data.machine is string && request.resource.data.machine.size() <= 80))
          && request.resource.data.date is string && request.resource.data.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.createdAt is number && request.resource.data.createdAt >= 0
          && request.resource.data.updatedAt is number && request.resource.data.updatedAt >= request.resource.data.createdAt;
      }
      match /blocked/{other} {
        allow get: if self(uid) || self(other);
        allow list: if self(uid);
        allow create, update: if self(uid) && uid != other
          && request.resource.data.keys().hasOnly(['createdAt']) && request.resource.data.createdAt == request.time;
        allow delete: if self(uid);
      }
    }

    match /counters/users {
      allow get: if verified();
      allow create, update: if verified()
        && request.resource.data.keys().hasOnly(['lastId'])
        && request.resource.data.lastId == nextNumber()
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.customId == request.resource.data.lastId
        && (!exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !('customId' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data))
        && allocation(request.auth.uid, request.resource.data.lastId);
    }
    match /userNumbers/{number} {
      allow get: if verified();
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && number == string(nextNumber())
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.customId == nextNumber()
        && getAfter(/databases/$(database)/documents/counters/users).data.lastId == nextNumber();
    }

    match /userAccess/{uid} {
      allow get: if self(uid) || owner();
      allow list: if owner();
      allow create, update: if owner()
        && request.resource.data.keys().hasOnly(['homeWorkouts', 'nutrition','profileCustomization','extraTrainingProfiles'])
        && request.resource.data.get('homeWorkouts', false) is bool
        && request.resource.data.get('nutrition', false) is bool
        && request.resource.data.get('profileCustomization',false) is bool
        && request.resource.data.get('extraTrainingProfiles',false) is bool;
      allow delete: if owner();
    }
    function nutritionAccess() {
      return verified() && (owner() || (exists(/databases/$(database)/documents/userAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/userAccess/$(request.auth.uid)).data.get('nutrition', false) == true));
    }
    function validNutritionDay(day) {
      return day is map && day.keys().hasOnly(['meals']) && day.meals is list && day.meals.size() == 4;
    }
    match /nutritionPlans/{id} {
      allow read: if nutritionAccess();
      allow create, update: if owner()
        && request.resource.data.keys().hasAll(['name', 'description', 'goal', 'diet', 'days', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'description', 'goal', 'diet', 'days', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.description is string && request.resource.data.description.size() <= 1000
        && request.resource.data.goal in ['Загальне меню', 'Підтримання ваги', 'Зниження ваги', 'Набір маси']
        && request.resource.data.diet in ['Звичайний раціон', 'Без риби', 'Без молочних продуктів', 'Вегетаріанський']
        && request.resource.data.updatedAt is number && request.resource.data.updatedAt >= 0
        && request.resource.data.days is list && request.resource.data.days.size() == 7
        && validNutritionDay(request.resource.data.days[0]) && validNutritionDay(request.resource.data.days[1])
        && validNutritionDay(request.resource.data.days[2]) && validNutritionDay(request.resource.data.days[3])
        && validNutritionDay(request.resource.data.days[4]) && validNutritionDay(request.resource.data.days[5])
        && validNutritionDay(request.resource.data.days[6]);
      allow delete: if owner();
    }
    function validNutritionInput(input) {
      return input is map
        && input.keys().hasAll(['goal','sex','age','height','weight','steps','workouts','adjustment','occupation','diet','basket','needsCare'])
        && input.keys().hasOnly(['goal','sex','age','height','weight','steps','workouts','adjustment','occupation','diet','basket','needsCare'])
        && input.goal in ['lose','maintain','gain'] && input.sex in ['male','female']
        && input.occupation in ['seated','standing','physical']
        && input.diet in ['regular','noFish','noDairy','vegetarian'] && input.basket in ['economy','standard','varied']
        && input.age is int && input.age >= 18 && input.age <= 80
        && input.height is number && input.height >= 130 && input.height <= 220
        && input.weight is number && input.weight >= 40 && input.weight <= 200
        && input.steps is int && input.steps >= 0 && input.steps <= 30000
        && input.workouts is int && input.workouts >= 0 && input.workouts <= 7
        && input.adjustment is int && input.adjustment >= 0 && input.adjustment <= 20
        && (input.goal != 'maintain' || input.adjustment == 0)
        && (input.goal != 'gain' || input.adjustment <= 15)
        && input.needsCare == false;
    }
    match /users/{uid}/nutrition/{id} {
      allow read: if self(uid) && nutritionAccess();
      allow create, update: if self(uid) && nutritionAccess() && (
        (id == 'selection'
          && request.resource.data.keys().hasAll(['planId', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['planId', 'updatedAt'])
          && request.resource.data.planId is string
          && exists(/databases/$(database)/documents/nutritionPlans/$(request.resource.data.planId))
          && request.resource.data.updatedAt is number && request.resource.data.updatedAt >= 0)
        || (id == 'generator'
          && request.resource.data.keys().hasAll(['version','input','seed','updatedAt'])
          && request.resource.data.keys().hasOnly(['version','input','seed','updatedAt'])
          && request.resource.data.version == 1 && validNutritionInput(request.resource.data.input)
          && request.resource.data.seed is int && request.resource.data.seed >= 0 && request.resource.data.seed <= 1000000
          && request.resource.data.updatedAt is number && request.resource.data.updatedAt >= 0)
      );
      allow delete: if self(uid);
    }
    match /settings/{id} {
      allow read: if verified();
      allow write: if owner();
    }
    match /programTemplates/{id} {
      allow read: if verified();
      allow write: if owner();
    }
    match /exercises/{id} {
      allow read: if verified();
      allow write: if owner();
    }
    // Reviews share validation for exercises and ready-made program templates.
    match /{catalog}/{id} {
      match /ratings/{uid} {
        allow read: if verified() && catalog in ['exercises', 'programTemplates'];
        allow create, update: if catalog in ['exercises', 'programTemplates'] && self(uid)
          && exists(/databases/$(database)/documents/$(catalog)/$(id))
          && request.resource.data.keys().hasAll(['score', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['score', 'updatedAt'])
          && request.resource.data.score is int && request.resource.data.score >= 1 && request.resource.data.score <= 5
          && request.resource.data.updatedAt == request.time;
        allow delete: if catalog in ['exercises', 'programTemplates'] && (self(uid) || owner());
      }
      match /comments/{comment} {
        allow read: if verified() && catalog in ['exercises', 'programTemplates'];
        allow create: if verified() && catalog in ['exercises', 'programTemplates']
          && exists(/databases/$(database)/documents/$(catalog)/$(id))
          && request.resource.data.keys().hasAll(['text', 'score', 'authorId', 'authorName', 'createdAt'])
          && request.resource.data.keys().hasOnly(['text', 'score', 'authorId', 'authorName', 'createdAt', 'richText'])
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorName == get(/databases/$(database)/documents/publicProfiles/$(request.auth.uid)).data.name
          && request.resource.data.score is int && request.resource.data.score >= 1 && request.resource.data.score <= 5
          && getAfter(/databases/$(database)/documents/$(catalog)/$(id)/ratings/$(request.auth.uid)).data.score == request.resource.data.score
          && validCommentFormatting()
          && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow delete: if catalog in ['exercises', 'programTemplates'] && (owner() || (verified() && resource.data.authorId == request.auth.uid));
      }
    }
    match /{kind}/{target}/comments/{comment}/reactions/{uid} {
      allow read: if verified() && kind in ['exercises', 'programTemplates', 'publicProfiles']
        && (kind != 'publicProfiles' || canViewProfile(target));
      allow create, update: if self(uid) && kind in ['exercises', 'programTemplates', 'publicProfiles']
        && exists(/databases/$(database)/documents/$(kind)/$(target)/comments/$(comment))
        && notBlocked(uid, get(/databases/$(database)/documents/$(kind)/$(target)/comments/$(comment)).data.authorId)
        && (kind != 'publicProfiles' || (canViewProfile(target) && notBlocked(uid, target)))
        && request.resource.data.keys().hasAll(['kind', 'createdAt'])
        && request.resource.data.keys().hasOnly(['kind', 'createdAt'])
        && request.resource.data.kind in ['like', 'love', 'fire', 'strong', 'laugh', 'dislike', 'wow', 'adore', 'giggle', 'angry', 'thinking']
        && request.resource.data.createdAt == request.time;
      allow delete: if self(uid) && kind in ['exercises', 'programTemplates', 'publicProfiles'];
    }
    match /sharedPrograms/{token} {
      allow get: if verified();
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['senderId', 'program'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.program is map;
      allow update: if verified() && resource.data.senderId == request.auth.uid
        && request.resource.data.senderId == resource.data.senderId
        && request.resource.data.keys().hasOnly(['senderId', 'program'])
        && request.resource.data.program is map;
      allow delete: if owner() || (verified() && resource.data.senderId == request.auth.uid);
    }
    function customizationAccess(uid) {
      return owner() || (exists(/databases/$(database)/documents/userAccess/$(uid)) && get(/databases/$(database)/documents/userAccess/$(uid)).data.get('profileCustomization',false) == true);
    }
    function validAppearance(a) {
      return a is map && a.keys().hasAll(['mode','background','backgroundEnd','blocks','text','angle','image'])
        && a.keys().hasOnly(['mode','background','backgroundEnd','blocks','text','angle','image','accent','buttonText','buttonStyle','buttonShape','buttonSize','cardShape','cardShadow','cardBorder','font','textSize','avatarShape','avatarRing','coverSize','heroAlign','layout','density','pattern','surface','coverStyle','avatarSize','nameStyle','imagePosition','hoverEffect','motion','headerMode','headerBackground','headerAccent','headerSurface','headerShape','headerTitle'])
        && a.get('background','#edf2ff') is string && a.get('background','#edf2ff').matches('#[0-9a-fA-F]{6}')
        && a.get('backgroundEnd','#e3f5ed') is string && a.get('backgroundEnd','#e3f5ed').matches('#[0-9a-fA-F]{6}')
        && a.get('blocks','#ffffff') is string && a.get('blocks','#ffffff').matches('#[0-9a-fA-F]{6}')
        && a.get('text','#202534') is string && a.get('text','#202534').matches('#[0-9a-fA-F]{6}')
        && a.get('accent','#2563eb') is string && a.get('accent','#2563eb').matches('#[0-9a-fA-F]{6}')
        && a.get('buttonText','#ffffff') is string && a.get('buttonText','#ffffff').matches('#[0-9a-fA-F]{6}')
        && a.get('mode','solid') in ['solid','gradient','dynamic','image']
        && a.get('buttonStyle','solid') in ['solid','outline','soft']
        && a.get('buttonShape','rounded') in ['rounded','pill','square']
        && a.get('buttonSize','normal') in ['normal','large']
        && a.get('cardShape','rounded') in ['rounded','soft','square']
        && a.get('cardShadow','soft') in ['none','soft','deep']
        && a.get('cardBorder','subtle') in ['subtle','accent','none']
        && a.get('font','system') in ['system','rounded','serif','mono']
        && a.get('textSize','normal') in ['normal','large']
        && a.get('avatarShape','rounded') in ['rounded','circle','square']
        && a.get('avatarRing','none') in ['none','accent','double']
        && a.get('coverSize','normal') in ['compact','normal','tall']
        && a.get('heroAlign','left') in ['left','center']
        && a.get('layout','right') in ['right','left','single']
        && a.get('density','normal') in ['normal','compact']
        && a.get('pattern','none') in ['none','dots','grid','diagonal']
        && a.get('surface','solid') in ['solid','tinted','glass']
        && a.get('coverStyle','classic') in ['classic','gradient','aurora','lines','solid']
        && a.get('avatarSize','normal') in ['small','normal','large']
        && a.get('nameStyle','normal') in ['normal','accent','gradient']
        && a.get('imagePosition','center') in ['top','center','bottom']
        && a.get('hoverEffect','none') in ['none','lift','glow']
        && a.get('motion','full') in ['full','gentle','none']
        // PROFILE HEADER BEGIN
        && a.get('headerMode','default') in ['default','profile','custom']
        && a.get('headerBackground','#ffffff') is string && a.get('headerBackground','#ffffff').matches('#[0-9a-fA-F]{6}')
        && a.get('headerAccent','#2563eb') is string && a.get('headerAccent','#2563eb').matches('#[0-9a-fA-F]{6}')
        && a.get('headerSurface','solid') in ['solid','glass','gradient']
        && a.get('headerShape','rounded') in ['rounded','pill','square']
        && a.get('headerTitle','Nexus GymB') is string && a.get('headerTitle','Nexus GymB').matches('[^[:cntrl:]]{1,32}')
        // PROFILE HEADER END
        && a.angle is int && a.angle >= 0 && a.angle <= 360
        && a.image is string && a.image.size() <= 300000
        && (a.image == '' || a.image.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'));
    }
    function validPublicProfile(uid) {
      let data = request.resource.data;
      let profile = get(/databases/$(database)/documents/users/$(uid)).data;
      return data.keys().hasAll(['name', 'photo', 'customId', 'joinedAt'])
        && data.keys().hasOnly(['name', 'photo', 'customId', 'joinedAt', 'contacts', 'visibility', 'bio', 'bioRich', 'banner', 'location', 'isPrivate','appearance'])
        && (!('appearance' in data) || data.appearance == null || validAppearance(data.appearance))
        && ((resource == null && !('appearance' in data))
          || (resource != null && !data.diff(resource.data).affectedKeys().hasAny(['appearance']))
          || customizationAccess(uid))
        && data.get('isPrivate', false) is bool
        && (data.get('isPrivate',false) == false || getAfter(/databases/$(database)/documents/profileCards/$(uid)).data.isPrivate == true)
        && data.get('location', '') is string && data.get('location', '').size() <= 100
        && data.get('banner', '') is string && data.get('banner', '').size() <= 480000
        && (data.get('banner', '') == '' || data.banner.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+'))
        && validContacts(data.get('contacts', {}))
        && validVisibility(data.get('visibility', {}))
        && (data.get('visibility',{}).get('calendar',false) == false || getAfter(/databases/$(database)/documents/publicProfiles/$(uid)/stats/calendar).data.scope == data.get('visibility',{}).get('calendarScope','all'))
        && data.get('bio', '') is string && data.get('bio', '').size() <= 400
        && data.get('bioRich','') is string && data.get('bioRich','').size() <= 8000
