      return d.keys().hasAll(['userId','email','subject','category','status','createdAt','updatedAt','lastSenderId','lastMessageId'])
        && d.keys().hasOnly(['userId','email','subject','category','status','createdAt','updatedAt','lastSenderId','lastMessageId'])
        && d.userId is string && d.email is string && d.email.size() >= 5 && d.email.size() <= 254
