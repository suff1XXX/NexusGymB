    }
    function achievementEarned(f,manual) { return [].concat(('first-workout' in manual || f.workouts >= 1) ? ['first-workout'] : []).concat(('five-workouts' in manual || f.workouts >= 5) ? ['five-workouts'] : []).concat(('twenty-workouts' in manual || f.workouts >= 20) ? ['twenty-workouts'] : []).concat(('fifty-workouts' in manual || f.workouts >= 50) ? ['fifty-workouts'] : []).concat(('hundred-sets' in manual || f.sets >= 100) ? ['hundred-sets'] : []).concat(('ten-tonnes' in manual || f.volume >= 10000) ? ['ten-tonnes'] : []).concat(('three-weeks' in manual || f.bestStreak >= 3) ? ['three-weeks'] : []).concat(('eight-exercises' in manual || f.variety >= 8) ? ['eight-exercises'] : []).concat(('first-program' in manual || f.programs >= 1) ? ['first-program'] : []).concat(('five-plans' in manual || f.planned >= 5) ? ['five-plans'] : []).concat(('personal-library' in manual || f.exercises >= 5) ? ['personal-library'] : []).concat(('first-bro' in manual || f.friends >= 1) ? ['first-bro'] : []).concat(('squad' in manual || f.friends >= 5) ? ['squad'] : []).concat(('profile-ready' in manual || f.profileComplete >= 1) ? ['profile-ready'] : []).concat(('first-comment' in manual || f.comments >= 1) ? ['first-comment'] : []).concat(('ten-comments' in manual || f.comments >= 10) ? ['ten-comments'] : []).concat(('seven-days' in manual || f.activeDays >= 7) ? ['seven-days'] : []).concat(('thirty-days' in manual || f.activeDays >= 30) ? ['thirty-days'] : []).concat(('ceo-praise' in manual) ? ['ceo-praise'] : []).concat(('best-gymbro' in manual || f.sharedWorkouts >= 5) ? ['best-gymbro'] : []).concat(('bad-gymbro' in manual) ? ['bad-gymbro'] : []).concat(('gymbro-challenge' in manual || f.challenges >= 1) ? ['gymbro-challenge'] : []); }
    function validAchievementProgress(uid) {
      let d=request.resource.data;
      let manual=achievementManual(uid);
      let f=d.facts;
      let earned=achievementEarned(f,manual);
      return d.keys().hasOnly(['earnedIds','manualIds','facts','score','catalogVersion','eventsVersion','updatedAt'])
        && d.catalogVersion == 3 && d.eventsVersion == 1 && d.updatedAt == request.time
        && f is map && f.keys().hasAll(['workouts','sets','volume','bestStreak','variety','sharedWorkouts','programs','planned','exercises','friends','profileComplete','comments','activeDays','challenges'])
