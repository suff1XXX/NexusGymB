    function achievementScore(ids) { return ('first-workout' in ids ? 25 : 0) + ('five-workouts' in ids ? 75 : 0) + ('twenty-workouts' in ids ? 200 : 0) + ('fifty-workouts' in ids ? 400 : 0) + ('hundred-sets' in ids ? 120 : 0) + ('ten-tonnes' in ids ? 150 : 0) + ('three-weeks' in ids ? 180 : 0) + ('eight-exercises' in ids ? 80 : 0) + ('first-program' in ids ? 20 : 0) + ('five-plans' in ids ? 50 : 0) + ('personal-library' in ids ? 40 : 0) + ('first-bro' in ids ? 35 : 0) + ('squad' in ids ? 100 : 0) + ('profile-ready' in ids ? 30 : 0) + ('first-comment' in ids ? 15 : 0) + ('ten-comments' in ids ? 65 : 0) + ('seven-days' in ids ? 60 : 0) + ('thirty-days' in ids ? 180 : 0) + ('ceo-praise' in ids ? 300 : 0) + ('best-gymbro' in ids ? 150 : 0) + ('bad-gymbro' in ids ? 0 : 0) + ('gymbro-challenge' in ids ? 100 : 0); }
    function validAchievementIds(ids) {
      return ids is list && ids.size() <= 22 && ids.toSet().size() == ids.size() && ids.hasOnly(['first-workout','five-workouts','twenty-workouts','fifty-workouts','hundred-sets','ten-tonnes','three-weeks','eight-exercises','first-program','five-plans','personal-library','first-bro','squad','profile-ready','first-comment','ten-comments','seven-days','thirty-days','ceo-praise','best-gymbro','bad-gymbro','gymbro-challenge']);
    }
    function achievementManual(uid) {
