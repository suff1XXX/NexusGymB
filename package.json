{
  "name": "nexus-gymb",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "build:achievements": "node scripts/build-achievements.mjs",
    "prepare:achievement-rules": "node scripts/update-spark-achievements.mjs && node scripts/update-training-experience-rules.mjs && node scripts/update-meeting-poll-rules.mjs && node scripts/update-exercise-notes-rules.mjs && node scripts/update-notification-history-rules.mjs && node scripts/update-profile-header-rules.mjs",
    "test:achievement-rules": "firebase emulators:exec --only firestore --project demo-nexus-gymb \"node qa/spark-achievements.rules.mjs\"",
    "test:optimization-browser": "node qa/optimization.browser.mjs",
    "prepare:appearance-rules": "node scripts/update-profile-appearance-rules.mjs",
    "test:appearance-rules": "firebase emulators:exec --only firestore --project demo-nexus-gymb \"node qa/profile-appearance.rules.mjs\"",
    "test:catalog-browser": "node tools/catalog-json.browser.mjs",
    "test:workout-browser": "node tools/workout-modes.browser.mjs",
    "test:browser": "node tools/browser-check.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-nexus-gymb \"node tools/rules-check.mjs\"",
    "start": "node tools/preview.mjs",
    "serve": "node tools/preview.mjs",
    "build:editor": "esbuild public/js/rich-editor.js --bundle --format=esm --target=es2022 --minify --legal-comments=inline --outfile=public/js/rich-editor.bundle.js",
    "pretest:browser": "npm run build:editor",
    "prestart": "npm run build:editor",
    "test:calendar-privacy-browser": "node tests/calendar-privacy.browser.mjs",
    "test:calendar-privacy-rules": "firebase emulators:exec --only firestore --project demo-nexus-calendar-privacy \"node tests/calendar-privacy.rules.mjs\"",
    "prepare:weight-details-rules": "node scripts/update-weight-details-rules.mjs",
    "prepare:calendar-privacy-rules": "node scripts/update-calendar-privacy-rules.mjs",
    "test:training-profiles-rules": "firebase emulators:exec --only firestore --project demo-nexus-training-profiles \"node tests/training-profiles.rules.mjs\"",
    "prepare:training-profiles-rules": "node scripts/update-training-profiles-rules.mjs",
    "prepare:workout-results-rules": "node scripts/update-workout-results-rules.mjs",
    "test:workout-results-browser": "node tests/workout-results.browser.mjs",
    "test:auth-browser": "node tests/auth-page.browser.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules --project nexus-gymb",
    "deploy:database": "firebase deploy --only firestore:rules,firestore:indexes --project nexus-gymb",
    "deploy:hosting": "firebase deploy --only hosting --project nexus-gymb"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "esbuild": "^0.28.2",
    "firebase": "^11.10.0",
    "playwright": "^1.65.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  },
  "dependencies": {
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-table": "^3.33.0",
    "@tiptap/extension-text-align": "^3.33.0",
    "@tiptap/extension-text-style": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "dompurify": "^3.4.17"
  }
}
